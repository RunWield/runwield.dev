---
import "@fontsource-variable/outfit";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const betaFormAction = import.meta.env.PUBLIC_BETA_FORM_ACTION || "mailto:beta@runwield.dev";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="theme-color" content="#0B1020"/>
    <meta name="description"
          content="RunWield turns a rough idea into a collaborative Plan, deliberate execution, and validation you can trust."/>
    <link rel="canonical" href={canonical}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="describedby" href="/llms.txt"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content="RunWield | Let AI agents make code changes without losing engineering control."/>
    <meta property="og:description" content="Rough idea to collaborative Plan to deliberate execution to validation."/>
    <meta property="og:image" content="https://runwield.dev/social-card.svg"/>
    <meta property="og:url" content={canonical}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <title>RunWield | Let agents change code. Keep engineering control.</title>
    <script is:inline>
        if (!window.location.hash) {
            history.scrollRestoration = "manual";

            const resetInitialScroll = () => {
                const root = document.documentElement;
                const previousBehavior = root.style.scrollBehavior;
                root.style.scrollBehavior = "auto";
                window.scrollTo(0, 0);
                root.style.scrollBehavior = previousBehavior;
            };

            resetInitialScroll();
            window.addEventListener("pageshow", resetInitialScroll, { once: true });
            window.addEventListener("load", resetInitialScroll, { once: true });
            document.fonts?.ready.then(resetInitialScroll);
        }
    </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<SiteHeader />

<main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy">
            <h1 id="hero-title" class="hero-title">
                <span class="hero-semantic-title">NOW you can let AI agents make code changes without losing engineering control.</span>
                <span class="hero-line" aria-hidden="true"><span>NOW you can let AI agents</span></span>
                <span class="hero-line" aria-hidden="true"><span>make code changes without</span></span>
                <span class="hero-line hero-line-accent" aria-hidden="true"><span>losing engineering control.</span></span>
            </h1>
            <div class="hero-flow" data-hero-item
                 aria-label="Rough idea to collaborative Plan to deliberate execution to validation">
                <span>Rough idea</span>{" "}
                <i aria-hidden="true">&rarr;</i>{" "}
                <span>Plan</span>{" "}
                <i aria-hidden="true">&rarr;</i>{" "}
                <span>execution</span>{" "}
                <i aria-hidden="true">&rarr;</i>{" "}
                <span>validation</span>{" "}
                <i aria-hidden="true">&rarr;</i>{" "}
                <span>record</span>{" "}
                <i aria-hidden="true">&rarr;</i>{" "}
                <span>better planning</span>
            </div>
            <div class="hero-support install-prompt" data-hero-item>
                <p>RunWield runs entirely on your machine. Use any model subscription or API key. No vendor lock-in.</p>
                <div class="install-command-shell">
                    <code data-install-command tabindex="0">curl -fsSL https://raw.githubusercontent.com/gandazgul/runwield/main/install.sh | bash</code>
                    <button type="button" data-copy-install aria-label="Copy install command">Copy</button>
                </div>
                <p class="install-status" data-install-status role="status" aria-live="polite"></p>
            </div>
        </div>

    </section>

    <section class="workflow section-shell" id="flow" aria-labelledby="workflow-title">
        <div class="section-heading">
            <div class="section-index" data-reveal>How it works</div>
            <h2 id="workflow-title" data-reveal>Introducing <span>RunWield</span></h2>
            <div class="workflow-copy" data-reveal>
                <h3 class="workflow-secondary">From chat and hope, to plan and prove.</h3>
                <p class="workflow-detail"><strong>Finally, a coding harness optimized for more than just getting an
                    agent spitting out code as fast as possible.</strong></p>
            </div>
        </div>

        <figure class="workflow-image" data-reveal>
            <video controls playsinline preload="none" width="1920" height="1080"
                   poster="media/runwield-demo-poster.jpg"
                   aria-label="90-second RunWield demo: Plan Review, execution, validation, Code Review, and Workspace">
                <source src="media/runwield-demo.mp4" type="video/mp4"/>
                <a href="media/runwield-demo.mp4">Watch the 90-second RunWield demo</a>
            </video>
        </figure>

        <section class="key-features" id="key-features" aria-labelledby="key-features-title">
            <h3 class="section-index" id="key-features-title">Key features</h3>
            <ul class="key-features-list">
                <li>
                    <h4>Any model. Subscription or API key.</h4>
                    <p>Use the models you want with the subscriptions or API keys you already have. Switch providers as your needs change.</p>
                </li>
                <li>
                    <h4>All local. Yours to control.</h4>
                    <p>RunWield runs on your machine. Your Plans, project context, memory, and Work Records live alongside your work.</p>
                </li>
                <li>
                    <h4>Review the Plan before the code.</h4>
                    <p>Shape the approach, add context, and choose how the agent should work before execution begins.</p>
                </li>
                <li>
                    <h4>Validation built into delivery.</h4>
                    <p>Run project checks, get an independent AI review, and inspect the diff. Findings feed directly into repair.</p>
                </li>
                <li>
                    <h4>Every change informs the next.</h4>
                    <p>Carry decisions and lessons forward through memory and Work Records, giving the next Plan a better starting point.</p>
                </li>
                <li>
                    <h4>Make the harness fit your workflow.</h4>
                    <p>Work from your terminal, browser, IDE, or chat. Extend RunWield with skills, MCP servers, and prompt templates.</p>
                </li>
            </ul>
            <a class="primary-action" href="/features">Explore all features <span aria-hidden="true">&rarr;</span></a>
        </section>
    </section>

    <section class="audience light-section" aria-labelledby="audience-title">
        <div class="section-index" data-reveal>Built for</div>

        <div class="audience-layout">
            <h2 id="audience-title" class="audience-lede" data-reveal>Engineers who want more from agents than faster
                code generation.</h2>
            <ul>
                <li data-reveal><span>01</span>{" "}Experienced developers working in real, existing codebases</li>
                <li data-reveal><span>02</span>{" "}Teams learning where agents should collaborate and where they can run
                </li>
                <li data-reveal><span>03</span>{" "}Anyone turning ambiguous product or engineering work into validated
                    change
                </li>
            </ul>
        </div>
    </section>

    <section class="why light-section" id="why" aria-labelledby="why-title">
        <div class="planning-heading">
            <div class="section-index" data-reveal>Why RunWield exists</div>
            <h2 id="why-title" data-reveal>Build faster. Keep the understanding.</h2>
            <p data-reveal>Steve Krouse’s <a href="https://blog.val.town/vibe-code">“Vibe code is legacy code”</a>{" "}captures
                the concern that led me to build RunWield: it’s easy to accumulate code faster than you understand
                it.</p>
            <p data-reveal>I built RunWield around reviewing the approach, checking the result, and carrying decisions
                and lessons into the next change. The aim is for your understanding to grow alongside your codebase.</p>
            <p data-reveal><a class="why-link" href="/blog/vibe-code-is-legacy-code">Read why I built RunWield →</a></p>
        </div>
    </section>

    <section class="planning light-section" id="planning" aria-labelledby="planning-title">
        <div class="planning-heading">
            <div class="section-index" data-reveal>Collaborative planning</div>
            <h2 id="planning-title" data-reveal>Planning gets better when everyone can point at the same thing.</h2>
            <p data-reveal>A Plan is not ceremony. It is the shared working surface where intent becomes specific enough
                for agents to act without guessing.</p>
        </div>

        <figure class="product-image" data-reveal>
            <div class="image-chrome"><span></span><span></span><span></span><small>RUNWIELD / PLAN REVIEW</small></div>
            <img src="images/plan-review.png"
                 alt="RunWield Plan Review showing a plan, table of contents, inline annotation, execution agent, collaboration mode, and approval action"
                 width="3024" height="1658" loading="lazy"/>
            <figcaption>
                <span>Plan Review</span>{" "}
                <span>Annotate, redline, attach context, choose how the work should run, and keep the Plan beside execution.</span>
            </figcaption>
        </figure>
    </section>

    <section class="proof light-section" id="proof" aria-labelledby="proof-title">
        <div class="section-index" data-reveal>Proof before done</div>
        <div class="proof-layout">
            <div class="proof-intro">
                <h2 id="proof-title" data-reveal>The agent said it's done. RunWield delivers proof.</h2>
            </div>
            <ol class="proof-list">
                <li data-reveal><span>01</span>
                    <div><strong>Mechanical validation</strong>
                        <p>Tests, types, lint, formatting, and project-specific checks run automatically. Failures go
                            back through automatic repair.</p></div>
                </li>
                <li data-reveal><span>02</span>
                    <div><strong>Automated LLM reviewer</strong>
                        <p>An independent reviewer compares the implementation with the Plan. Material findings trigger
                            another repair pass.</p></div>
                </li>
                <li data-reveal><span>03</span>
                    <div><strong>Human review, guided</strong>
                        <p>Inspect the diff, follow review cues, annotate exact lines, and approve only when the
                            evidence supports the result.</p></div>
                </li>
            </ol>
        </div>

        <figure class="review-image" data-reveal>
            <div class="image-chrome"><span></span><span></span><span></span><small>RUNWIELD / CODE REVIEW</small></div>
            <img src="images/code-review.png"
                 alt="RunWield Code Review showing a side-by-side diff, changed files, inline annotation, Guided Review status, and approval action"
                 width="1920" height="910" loading="lazy"/>
            <figcaption>
                <span>Code Review</span>{" "}
                <span>Review the exact change, annotate the diff, and keep feedback and repair inside the same workflow.</span>
            </figcaption>
        </figure>
    </section>

    <section class="beta section-shell" id="beta" aria-labelledby="beta-title">
        <div class="beta-intro">
            <div class="section-index" data-reveal>Try it with me</div>
            <h2 id="beta-title" data-reveal>Help shape a better way to build with agents.</h2>
            <p data-reveal>We're looking for experienced developers using AI on real codebases.</p>
        </div>

        <form class="beta-form" action={betaFormAction} method="post" data-beta-form data-reveal>
            <div class="install-prompt">
                <div class="install-prompt-heading">
                    <h3>Install in 30 seconds</h3>
                </div>
                <div class="install-command-shell">
                    <code data-install-command tabindex="0">curl -fsSL https://raw.githubusercontent.com/gandazgul/runwield/main/install.sh | bash</code>
                    <button type="button" data-copy-install>Copy</button>
                </div>
                <p class="install-status" data-install-status role="status" aria-live="polite"></p>
            </div>
            <h3 class="form-heading">Reach out</h3>
            <div class="field-row">
                <label>Name<input name="name" autocomplete="name" required/></label>
                <label>Email<input name="email" type="email" autocomplete="email" required/></label>
            </div>
            <div class="field-row">
                <label>Role<input name="role" autocomplete="organization-title" required/></label>
                <label>Repo or team size<input name="team_size" placeholder="e.g. 8 developers, 250k LOC"
                                               required/></label>
            </div>
            <label>AI coding tools you use<input name="tools" placeholder="Claude Code, Codex, Cursor..."
                                                 required/></label>
            <label>Where does your current agent workflow break down?<textarea name="pain" rows="4" required></textarea></label>
            <div class="form-footer">
                <p>Your context helps us find the right early users. No mailing list noise.</p>
                <button class="primary-action" type="submit">Try it with me <span aria-hidden="true">&#8599;</span></button>
            </div>
            <p class="form-status" data-form-status role="status" aria-live="polite"></p>
            <div class="form-delivery" data-form-delivery hidden>
                <div>
                    <strong>Email app didn't open?</strong>
                    <p>Open it again, or copy the prepared request and send it to <a href="mailto:beta@runwield.dev">beta@runwield.dev</a>.
                    </p>
                </div>
                <div class="delivery-actions">
                    <a class="secondary-action" data-email-link href="mailto:beta@runwield.dev">Open email again <span
                            aria-hidden="true">&#8599;</span></a>
                    <button class="secondary-action" type="button" data-copy-request>Copy request <span
                            aria-hidden="true">&#10697;</span></button>
                </div>
                <label>Prepared request<textarea data-request-text rows="10" readonly></textarea></label>
            </div>
        </form>
    </section>
</main>

<SiteFooter />

<script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealItems = document.querySelectorAll("[data-reveal]");

    if (reducedMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
        const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                currentObserver.unobserve(entry.target);
            });
        }, { threshold: 0.15, rootMargin: "0px 0px -50px" });

        revealItems.forEach((item) => observer.observe(item));
    }

    const workflowSection = document.querySelector(".workflow");
    const desktopWorkflow = window.matchMedia("(min-width: 901px)");
    let workflowFrame = 0;

    const updateWorkflowPosition = () => {
        workflowFrame = 0;
        if (!(workflowSection instanceof HTMLElement)) return;

        if (!desktopWorkflow.matches) {
            workflowSection.style.removeProperty("opacity");
            workflowSection.style.removeProperty("transform");
            workflowSection.style.removeProperty("will-change");
            return;
        }

        const progress = reducedMotion ? Number(window.scrollY > 8) : Math.min(Math.max(window.scrollY / 360, 0), 1);
        workflowSection.style.opacity = `${progress}`;
        workflowSection.style.transform = reducedMotion ? "none" : `translate3d(0, ${(1 - progress) * 140}px, 0)`;
        workflowSection.style.willChange = progress > 0 && progress < 1 ? "transform, opacity" : "";
    };

    const requestWorkflowPosition = () => {
        if (workflowFrame) return;
        workflowFrame = window.requestAnimationFrame(updateWorkflowPosition);
    };

    updateWorkflowPosition();
    window.addEventListener("scroll", requestWorkflowPosition, { passive: true });
    window.addEventListener("resize", requestWorkflowPosition, { passive: true });
    window.addEventListener("load", requestWorkflowPosition, { once: true });
    window.addEventListener("pageshow", requestWorkflowPosition, { once: true });

    const betaForm = document.querySelector("[data-beta-form]");
    betaForm?.addEventListener("submit", (event) => {
        if (!(betaForm instanceof HTMLFormElement) || !betaForm.action.startsWith("mailto:")) return;
        event.preventDefault();

        const data = new FormData(betaForm);
        const lines = [
            `Name: ${data.get("name")}`,
            `Email: ${data.get("email")}`,
            `Role: ${data.get("role")}`,
            `Repo or team size: ${data.get("team_size")}`,
            `AI coding tools: ${data.get("tools")}`,
            "",
            "Where the current agent workflow breaks down:",
            `${data.get("pain")}`,
        ];
        const subject = encodeURIComponent("Try RunWield with me");
        const body = encodeURIComponent(lines.join("\n"));
        const emailUrl = `${betaForm.action}?subject=${subject}&body=${body}`;

        const status = document.querySelector("[data-form-status]");
        const delivery = document.querySelector("[data-form-delivery]");
        const emailLink = document.querySelector("[data-email-link]");
        const requestText = document.querySelector("[data-request-text]");
        if (emailLink instanceof HTMLAnchorElement) emailLink.href = emailUrl;
        if (requestText instanceof HTMLTextAreaElement) requestText.value = lines.join("\n");
        if (delivery instanceof HTMLElement) delivery.hidden = false;
        if (status) status.textContent = "Request ready. Open your email app or copy it below.";
    });

    const copyRequest = document.querySelector("[data-copy-request]");
    copyRequest?.addEventListener("click", async () => {
        const requestText = document.querySelector("[data-request-text]");
        const status = document.querySelector("[data-form-status]");
        if (!(requestText instanceof HTMLTextAreaElement)) return;

        try {
            await navigator.clipboard.writeText(requestText.value);
        } catch {
            requestText.focus();
            requestText.select();
            if (status) status.textContent = "Request selected. Press Cmd+C or Ctrl+C, then send it to beta@runwield.dev.";
            return;
        }

        if (status) status.textContent = "Request copied. Send it to beta@runwield.dev.";
    });

    document.querySelectorAll(".install-prompt").forEach((prompt) => {
        const installCommand = prompt.querySelector("[data-install-command]");
        const copyInstall = prompt.querySelector("[data-copy-install]");
        const installStatus = prompt.querySelector("[data-install-status]");

        const selectInstallCommand = () => {
            if (!(installCommand instanceof HTMLElement)) return;
            const range = document.createRange();
            const selection = window.getSelection();
            if (!selection) return;
            range.selectNodeContents(installCommand);
            selection.removeAllRanges();
            selection.addRange(range);
        };

        installCommand?.addEventListener("dblclick", selectInstallCommand);

        copyInstall?.addEventListener("click", async () => {
            const command = installCommand?.textContent?.trim();
            if (!command) return;

            try {
                await navigator.clipboard.writeText(command);
                if (installStatus) installStatus.textContent = "Install command copied.";
            } catch {
                selectInstallCommand();
                if (installStatus) installStatus.textContent = "Command selected. Press Cmd+C or Ctrl+C to copy.";
            }
        });
    });
</script>
</body>
</html>
