---
import BrandTitle from "../../components/BrandTitle.astro";
import type { MarkdownInstance } from "astro";
import BlogLayout from "../../layouts/BlogLayout.astro";

interface PostFrontmatter {
    title: string;
    description: string;
    publishedDate: string;
    author: string;
    authorUrl: string;
}
const posts = Object.values(import.meta.glob<MarkdownInstance<PostFrontmatter>>("./*.md", { eager: true }))
    .filter((post) => post.url)
    .sort((a, b) => b.frontmatter.publishedDate.localeCompare(a.frontmatter.publishedDate) || a.file.localeCompare(b.file));
const dateLabel = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", {
    timeZone: "UTC", year: "numeric", month: "long", day: "numeric",
});
---
<BlogLayout title="Wield Notes" description="Engineering judgment in the age of AI.">
    <div class="blog-column blog-index">
        <div class="blog-index-heading">
            <h1>Wield Notes</h1>
            <img src="/mascot/reviewer.svg" width="52" height="72" alt="" aria-hidden="true" />
        </div>
        <p class="blog-subtitle">Engineering judgment in the age of AI.</p>
        <ul class="post-list">
            {posts.map((post) => <li>
                <time datetime={post.frontmatter.publishedDate}>{dateLabel(post.frontmatter.publishedDate)}</time>
                <h2><a href={post.url}><BrandTitle text={post.frontmatter.title} /></a></h2>
                <p>{post.frontmatter.description}</p>
            </li>)}
        </ul>
    </div>
</BlogLayout>
