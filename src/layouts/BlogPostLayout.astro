---
import BrandTitle from "../components/BrandTitle.astro";
import type { MarkdownLayoutProps } from "astro";
import BlogLayout from "./BlogLayout.astro";

interface PostFrontmatter {
    title: string;
    description: string;
    publishedDate: string;
    author: string;
    authorUrl: string;
}
type Props = MarkdownLayoutProps<PostFrontmatter>;
const { frontmatter } = Astro.props;
const { title, description, publishedDate, author, authorUrl } = frontmatter;
const dateLabel = new Date(`${publishedDate}T12:00:00Z`).toLocaleDateString("en-US", {
    timeZone: "UTC", year: "numeric", month: "long", day: "numeric",
});
---
<BlogLayout title={title} description={description} type="article">
    <article class="blog-column blog-article">
        <header class="article-header">
            <h1><BrandTitle text={title} /></h1>
            <div class="article-meta">
                <time datetime={publishedDate}>{dateLabel}</time>
                <span aria-hidden="true">·</span>
                <a href={authorUrl}>{author}</a>
            </div>
        </header>
        <div class="article-body"><slot /></div>
        <a class="back-link" href="/blog"><img src="/mascot/reviewer.svg" width="26" height="36" alt="" aria-hidden="true" />Back to Wield Notes</a>
    </article>
</BlogLayout>
