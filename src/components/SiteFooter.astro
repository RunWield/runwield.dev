---
const isHome = Astro.url.pathname === "/";
---
<footer class="site-footer" data-reveal={isHome ? "" : undefined}>
    <a class="brand" href="/" aria-label="RunWield home">
        <img src="/logo.svg" alt="" width="42" height="33"/>
        <span>Run<span class="brand-accent">Wield</span></span>
    </a>
    <p>A plan-by-default coding harness.</p>
    <div><a href="/features">Features</a><a href="https://github.com/RunWield/runwield">GitHub</a><a
            href="https://docs.runwield.dev">Docs</a><a href="/privacy">Privacy</a><span>&copy; {new Date().getFullYear()} RunWield</span>
    </div>
</footer>
