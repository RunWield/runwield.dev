---
const isBlog = Astro.url.pathname.startsWith("/blog");
const isHome = Astro.url.pathname === "/";
---
<header class:list={["site-header", { "blog-header": !isHome }]}>
    <a class="brand" href="/" aria-label="RunWield home">
        <img src="/logo.svg" alt="" width="42" height="33"/>
        <span>Run<span class="brand-accent">Wield</span></span>
    </a>
    <nav aria-label="Primary navigation">
        <a href="/#flow">How it works</a>
        <a href="/features" aria-current={Astro.url.pathname === "/features" ? "page" : undefined}>Features</a>
        <a href="/blog" aria-current={Astro.url.pathname === "/blog" ? "page" : undefined} class:list={[{ "blog-active": isBlog }]}>Wield Notes</a>
        <a href="https://docs.runwield.dev">Docs</a>
        <a href="https://github.com/RunWield/runwield/releases/latest">Latest release</a>
        <a class="primary-action" href="/#beta">Try it with me <span aria-hidden="true">&#8599;</span></a>
    </nav>
</header>
